FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY *.py ./
COPY static ./static
RUN mkdir -p /data
ENV SIGNAL_ALERT_DB=/data/alerts.sqlite3 PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "uvicorn monitor_service:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
