# API 키를 코드나 브라우저에 넣지 마세요. 이 파일을 .env 로 복사한 뒤 값만 입력합니다.
# 한국 공식 공시: https://opendart.fss.or.kr/
DART_API_KEY=
# 미국 SEC는 실제 연락 가능한 메일을 포함한 User-Agent를 권장/요구합니다.
# 예: YourApplicationName your-real-email@example.org
SEC_USER_AGENT=
# 선택: 미니 종목 질문 AI. 질문할 때만 유료 호출하며, 키가 없으면 자료 기반 안내를 제공합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 선택: 텔레그램 가격 기준 및 보수적 매수검토 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 선택: 화면을 닫아도 감시하는 별도 상시 실행 서버 (docs/alerts.md)
# Vercel에는 해당 감시 서버의 HTTPS 주소만 설정합니다.
ALERT_SERVICE_URL=
# 감시 서버에만 설정하는 전용 개인 접속키(24자 이상). 브라우저의 감시 접속란에 입력.
# 키의 실제 값은 GitHub 또는 채팅에 올리지 마세요.
ALERT_ACCESS_TOKEN=
# 감시 서버의 영속 디스크 경로. Vercel의 임시 파일시스템에서는 실행하지 않습니다.
SIGNAL_ALERT_DB=
ALERT_POLL_SECONDS=15

# 선택: 한국투자증권 KIS Open API (미래에셋 계좌는 주문용으로 유지 가능)
# https://apiportal.koreainvestment.com/
# KIS 접근 권한과 시세 사용 약관을 반드시 확인하세요. 장중 실시간성은 별도 검증 필요.
KIS_APP_KEY=
KIS_APP_SECRET=

# 공개 웹앱은 개인 비밀번호가 없습니다. AI 질문을 사용하려면 OPENAI_API_KEY를 서버/Vercel 환경변수에만 설정하세요.
# 자동 일괄 AI 요약은 공개 앱에서 계속 비활성입니다. 질문 호출 제한은 프로세스 단위입니다.
